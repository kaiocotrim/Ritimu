generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model User {
  id                          String                       @id
  name                        String
  email                       String
  emailVerified               Boolean                      @default(false)
  image                       String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  sessions                    Session[]
  accounts                    Account[]
  classroomCourses            ClassroomCourse[]
  classroomItemCompletions    ClassroomItemCompletion[]
  calendarEvents              CalendarEvent[]
  calendarEventDayCompletions CalendarEventDayCompletion[]
  studyPreference             StudyPreference?
  studyAvailabilities         StudyAvailability[]
  studySubjectPreferences     StudySubjectPreference[]
  studyPlans                  StudyPlan[]
  studyContents               StudyContent[]
  xpTransactions              XpTransaction[]
  x1MatchesAsX                X1Match[]                    @relation("X1PlayerX")
  x1MatchesAsO                X1Match[]                    @relation("X1PlayerO")
  x1MatchesWon                X1Match[]                    @relation("X1Winner")
  x1Moves                     X1Move[]

  @@unique([email])
  @@map("user")
}

enum X1MatchStatus {
  WAITING
  PREPARING
  PLAYING
  FINISHED
  ABANDONED
  CANCELED
}

enum X1BotDifficulty {
  EASY
  MEDIUM
  HARD
}

enum X1QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum X1QuestionSource {
  MANUAL
  AI
}

enum X1QuestionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum X1PreparationStatus {
  SEARCHING_DATABASE
  GENERATING_QUESTIONS
  READY
  FAILED
}

model KnowledgeTopic {
  id             String       @id @default(cuid())
  name           String
  normalizedName String       @unique
  slug           String       @unique
  icon           String?
  active         Boolean      @default(true)
  createdById    String?
  questions      X1Question[]
  matches        X1Match[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([normalizedName])
}

model X1Question {
  id            String                 @id @default(cuid())
  subject       String
  question      String
  options       Json
  correctAnswer String
  explanation   String?
  difficulty    X1QuestionDifficulty   @default(MEDIUM)
  subtopic      String?
  source        X1QuestionSource       @default(MANUAL)
  reviewStatus  X1QuestionReviewStatus @default(APPROVED)
  fingerprint   String?                @unique
  topicId       String?
  topic         KnowledgeTopic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  active        Boolean                @default(true)
  moves         X1Move[]
  reservations  X1MatchQuestion[]
  matches       X1Match[]              @relation("X1CurrentQuestion")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([subject, active])
  @@index([topicId, difficulty, active])
}

model X1Match {
  id                  String               @id @default(cuid())
  code                String               @unique
  status              X1MatchStatus        @default(WAITING)
  playerXId           String
  playerX             User                 @relation("X1PlayerX", fields: [playerXId], references: [id], onDelete: Cascade)
  playerOId           String?
  playerO             User?                @relation("X1PlayerO", fields: [playerOId], references: [id], onDelete: SetNull)
  playerXSubject      String?
  playerOSubject      String?
  topicId             String?
  topic               KnowledgeTopic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopic            String?
  questionDifficulty  X1QuestionDifficulty @default(MEDIUM)
  preparationStatus   X1PreparationStatus  @default(SEARCHING_DATABASE)
  preparedCount       Int                  @default(0)
  requiredCount       Int                  @default(12)
  preparationError    String?
  preparationLockedAt DateTime?
  currentTurnUserId   String?
  currentQuestionId   String?
  currentQuestion     X1Question?          @relation("X1CurrentQuestion", fields: [currentQuestionId], references: [id], onDelete: SetNull)
  currentCell         Int?
  turnTimeSeconds     Int?
  allowCapture        Boolean              @default(false)
  turnStartedAt       DateTime?
  isBotMatch          Boolean              @default(false)
  botDifficulty       X1BotDifficulty?
  winnerId            String?
  winner              User?                @relation("X1Winner", fields: [winnerId], references: [id], onDelete: SetNull)
  board               Json
  moves               X1Move[]
  reservedQuestions   X1MatchQuestion[]
  createdAt           DateTime             @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  updatedAt           DateTime             @updatedAt

  @@index([playerXId, status])
  @@index([playerOId, status])
}

model X1MatchQuestion {
  id         String     @id @default(cuid())
  matchId    String
  match      X1Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  questionId String
  question   X1Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  order      Int
  used       Boolean    @default(false)
  usedAt     DateTime?
  createdAt  DateTime   @default(now())

  @@unique([matchId, order])
  @@unique([matchId, questionId])
  @@index([matchId, used, order])
}

model X1Move {
  id             String     @id @default(cuid())
  matchId        String
  match          X1Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId       String?
  player         User?      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  isBot          Boolean    @default(false)
  cell           Int
  questionId     String
  question       X1Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedAnswer String
  correct        Boolean
  createdAt      DateTime   @default(now())

  @@index([matchId, createdAt])
  @@index([playerId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ClassroomCourse {
  id             String  @id @default(cuid())
  googleCourseId String
  name           String
  section        String?
  classroomUrl   String?
  calendarId     String?
  courseState    String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments      ClassroomAssignment[]
  itemCompletions  ClassroomItemCompletion[]
  studyPreferences StudySubjectPreference[]
  studySessions    StudySession[]
  studyContents    StudyContent[]
  totalItems       Int                       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, googleCourseId])
  @@index([userId])
}

model ClassroomAssignment {
  id                 String @id @default(cuid())
  googleAssignmentId String

  title       String
  description String?

  dueDate      DateTime?
  maxPoints    Float?
  state        String?
  workType     String?
  classroomUrl String?

  courseId         String
  course           ClassroomCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  calendarEvents   CalendarEvent[]
  studySessions    StudySession[]
  importance       Int             @default(3)
  estimatedMinutes Int             @default(40)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, googleAssignmentId])
  @@index([courseId])
}

enum StudySessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
  RESCHEDULED
  CANCELED
}

enum StudyPlanPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum StudyPlanStatus {
  CONFIRMED
  CANCELED
}

enum CalendarSyncStatus {
  NOT_REQUESTED
  PENDING
  SYNCED
  FAILED
}

model StudyPreference {
  id                    String               @id @default(cuid())
  userId                String               @unique
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultSessionMinutes Int                  @default(40)
  breakMinutes          Int                  @default(10)
  maxDailyMinutes       Int                  @default(120)
  studyOnWeekends       Boolean              @default(false)
  timeZone              String               @default("America/Sao_Paulo")
  syncWithGoogleDefault Boolean              @default(false)
  plannerView           StudyPlanPeriodType?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model CalendarEventDayCompletion {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarEventId String
  calendarEvent   CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  occurrenceDate  DateTime
  completedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@unique([calendarEventId, occurrenceDate])
  @@index([userId, occurrenceDate])
}

model StudyAvailability {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekday])
  @@index([userId])
}

model StudySubjectPreference {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     ClassroomCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  difficulty Int             @default(3)

  @@unique([userId, courseId])
  @@index([userId])
}

model StudyPlan {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDate       DateTime
  periodType     StudyPlanPeriodType @default(DAILY)
  startDate      DateTime?
  endDate        DateTime?
  status         StudyPlanStatus     @default(CONFIRMED)
  syncWithGoogle Boolean             @default(false)
  confirmedAt    DateTime?
  totalMinutes   Int                 @default(0)
  sessions       StudySession[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([userId, planDate])
  @@index([userId, planDate])
}

model StudySession {
  id                    String               @id @default(cuid())
  studyPlanId           String
  studyPlan             StudyPlan            @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  courseId              String?
  course                ClassroomCourse?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  classroomAssignmentId String?
  classroomAssignment   ClassroomAssignment? @relation(fields: [classroomAssignmentId], references: [id], onDelete: SetNull)
  calendarEvent         CalendarEvent?
  studyContentId        String?
  studyContent          StudyContent?        @relation(fields: [studyContentId], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  subjectName           String?
  externalTaskId        String?
  externalUrl           String?
  priorityReason        String?
  priorityScore         Int
  scheduledStart        DateTime
  scheduledEnd          DateTime
  status                StudySessionStatus   @default(PENDING)
  completedAt           DateTime?
  durationMinutes       Int                  @default(40)
  syncStatus            CalendarSyncStatus   @default(NOT_REQUESTED)
  syncError             String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([studyPlanId, scheduledStart])
  @@index([classroomAssignmentId])
  @@index([courseId])
  @@index([studyContentId])
}

model StudyContent {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String?
  course           ClassroomCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  dueDate          DateTime?
  importance       Int              @default(3)
  estimatedMinutes Int              @default(40)
  studied          Boolean          @default(false)
  sessions         StudySession[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId, studied])
  @@index([courseId])
}

enum CalendarEventSource {
  RITIMU
  GOOGLE
  CLASSROOM
}

enum CalendarEventType {
  STUDY
  CLASS
  EXAM
  ASSIGNMENT
  PERSONAL
  OTHER
}

enum CalendarEventStatus {
  PENDING
  COMPLETED
  CANCELED
}

model CalendarEvent {
  id                    String                       @id @default(cuid())
  title                 String
  description           String?
  startAt               DateTime
  endAt                 DateTime?
  allDay                Boolean                      @default(false)
  source                CalendarEventSource          @default(RITIMU)
  type                  CalendarEventType            @default(STUDY)
  status                CalendarEventStatus          @default(PENDING)
  routineType           String                       @default("OTHER")
  recurrence            String                       @default("NONE")
  recurrenceDays        Int[]                        @default([])
  recurrenceUntil       DateTime?
  googleEventId         String?
  googleCalendarId      String?
  syncedWithGoogle      Boolean                      @default(false)
  googleUpdatedAt       DateTime?
  classroomAssignmentId String?
  classroomAssignment   ClassroomAssignment?         @relation(fields: [classroomAssignmentId], references: [id], onDelete: SetNull)
  studySessionId        String?                      @unique
  studySession          StudySession?                @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  dayCompletions        CalendarEventDayCompletion[]

  @@unique([userId, googleCalendarId, googleEventId])
  @@index([userId, startAt])
  @@index([userId, recurrence])
  @@index([classroomAssignmentId])
}

model ClassroomItemCompletion {
  id        String  @id @default(cuid())
  itemKey   String
  completed Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   ClassroomCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId, itemKey])
  @@index([userId, courseId, completed])
}

enum XpSource {
  CLASSROOM_ITEM
  STUDY_SESSION
  STUDY_CONTENT
  MISSION
}

model XpTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  source      XpSource
  referenceId String
  description String
  earnedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, source, referenceId])
  @@index([userId, earnedAt])
  @@index([source, referenceId])
}
